# Rendered output
out/
snapshots/
.hyperframes/

# Generated audio (reproducible: python tools/make_audio.py)
assets/audio/*.wav

# Large capture media - screen recordings stay out of git; PNG screenshots may be committed
captures/*.mp4
captures/*.webm
captures/*.mov
# The repo root ignores *.png / *.jpg; screenshots in captures/ are film sources, so commit them.
!captures/*.png
!captures/*.jpg

node_modules/
assets/audio/cuts.json
