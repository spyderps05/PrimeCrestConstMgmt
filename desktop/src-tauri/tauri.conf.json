{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrimeCrest",
  "version": "18.9.0",
  "identifier": "pk.spydersolutions.primecrest",
  "mainBinaryName": "PrimeCrest",
  "build": {
    "frontendDist": "../../frontend/dist",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "splash.html",
        "title": "PrimeCrest",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "visible": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "PrimeCrest Construction Management"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "Spyder Solutions",
    "copyright": "© 2026 Spyder Solutions. All rights reserved.",
    "category": "Business",
    "shortDescription": "PrimeCrest Construction Management — BOQ, cost control, and project delivery.",
    "longDescription": "PrimeCrest Construction Management by Spyder Solutions is a construction project management platform for cost estimation, bills of quantities, and data validation, with CAD/BIM quantity takeoff and multi-currency support. It runs fully local on an embedded database, so there is no Python install or extra setup to manage. Import, validate, estimate, and report from a single desktop app that works offline.",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/primecrest-server"
    ],
    "resources": {
      "resources/converters": "converters"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh",
        "template": "windows/installer.nsi",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "German",
          "French",
          "Spanish",
          "SpanishInternational",
          "Italian",
          "Portuguese",
          "PortugueseBR",
          "Dutch",
          "Polish",
          "Norwegian",
          "Swedish",
          "Bulgarian",
          "Russian",
          "Turkish",
          "Arabic",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "Vietnamese"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"],
        "section": "science"
      },
      "rpm": {
        "compression": {
          "type": "none"
        }
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
